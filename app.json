{
  "expo": {
    "name": "Asistanım",
    "slug": "asistanim",
    "version": "1.0.0",
    "description": "Kişisel sekreter: not alır, hatırlatır, süreçleri yürütür. Claude destekli, SQLite tabanlı mobil uygulama.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asistanim",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ahsenyenisey.asistanim",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Notlara fotoğraf eklemek için kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Notlara galeriden görsel eklemek için kullanılır."
      }
    },
    "android": {
      "package": "com.ahsenyenisey.asistanim",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Notlara galeriden görsel eklemek için kullanılır.",
          "cameraPermission": "Notlara fotoğraf eklemek için kamera kullanılır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
